# Server-only. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# Use an address on your verified Resend sending domain.
CONTACT_FROM_EMAIL=
# Supabase (admin at /admin). The anon key is public by design; row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Gemini API key. Never expose this through a NEXT_PUBLIC_ variable.
GEMINI_API_KEY=
# Optional model identifier used for proposal generation.
GEMINI_MODEL=gemini-3.8-flash
# Campaign measurement and contact. All optional: each feature stays off until its value is set.
# These are public by design (they end up in the browser). Set them in the hosting provider and redeploy.
# Meta Pixel ID: digits only (Events Manager > Data sources).
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API. Server-only: never prefix these with NEXT_PUBLIC_. Needs NEXT_PUBLIC_META_PIXEL_ID too.
# A server Lead is sent only when the visitor accepted measurement cookies, with the same event id as the Pixel.
# Access token from Events Manager > your Pixel > Settings > Conversions API > Generate access token.
META_CAPI_TOKEN=
# Optional: code from Events Manager > Test events, to see server events there. Remove it after testing.
META_TEST_EVENT_CODE=
# Optional Graph API version for the Conversions API endpoint, e.g. v26.0. Empty uses the built-in default.
META_GRAPH_VERSION=
# Google Analytics 4 measurement ID, looks like G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=
# WhatsApp business number with country code, e.g. 573001234567. Shows the "write on WhatsApp" button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Public URL of the data processing policy (https://... or /path). Shows the link under the form.
NEXT_PUBLIC_PRIVACY_URL=
